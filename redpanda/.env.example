# ── Redpanda external advertised address ──────────────────────────────────────
# Set this to the public IP or hostname of the server running Redpanda.
# External Kafka clients (outside Docker) will connect to this address.
REDPANDA_EXTERNAL_HOST=your-server-ip-or-domain

# ── Ports (change only if you have conflicts) ─────────────────────────────────
REDPANDA_KAFKA_PORT=9092
REDPANDA_KAFKA_EXTERNAL_PORT=19092
REDPANDA_HTTP_PROXY_PORT=8082
REDPANDA_HTTP_PROXY_EXTERNAL_PORT=18082
REDPANDA_SCHEMA_REGISTRY_PORT=8081
REDPANDA_SCHEMA_REGISTRY_EXTERNAL_PORT=18081
REDPANDA_ADMIN_PORT=9644
CONSOLE_PORT=8080

# ── Topics ───────────────────────────────────────────────────────────────────
# Partition count for auto-created topics (default: 3)
TOPIC_PARTITIONS=3
# Replication factor — must be <= number of brokers (single-node: 1)
TOPIC_REPLICAS=1

# ── Tuning ────────────────────────────────────────────────────────────────────
# smp = number of CPU cores to use (adjust to your VM's core count)
REDPANDA_SMP=1
# Memory to reserve for Redpanda (e.g., 1G, 2G, 4G)
REDPANDA_MEMORY=1G
# Log verbosity: warn | info | debug | trace
REDPANDA_LOG_LEVEL=warn
