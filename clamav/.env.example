# ── Network ───────────────────────────────────────────────────────────────────
# Port exposed on the host for clamd TCP socket connections.
CLAMAV_PORT=3310

# ── Freshclam (virus DB update daemon) ────────────────────────────────────────
# How many times per day freshclam checks for DB updates. Max: 24.
FRESHCLAM_CHECKS_PER_DAY=24

# ── Scanner limits ────────────────────────────────────────────────────────────
# Maximum file size to scan (bytes). Files larger than this are skipped.
# Default: 26214400 (25 MB)
CLAMD_MAX_FILE_SIZE=26214400

# Maximum total scan size when expanding archives (bytes).
# Default: 104857600 (100 MB)
CLAMD_MAX_SCAN_SIZE=104857600

# Maximum data per scan request over TCP socket (bytes).
# Default: 26214400 (25 MB)
CLAMD_STREAM_MAX_LENGTH=26214400

# Number of concurrent scanner threads. Match to your CPU core count.
CLAMD_MAX_THREADS=4
